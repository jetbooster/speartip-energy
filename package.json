{
  "name": "live-foxcloud-data-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build --emptyOutDir",
    "dev": "bunx --bun vite",
    "dev:remote": "bun server/dev/index.ts remote",
    "dev:mock": "bun server/dev/index.ts mock",
    "tsc": "tsc -b",
    "lint": "eslint .",
    "test": "bun run test:server && bun run test:frontend",
    "test:server": "bun test server",
    "test:frontend": "bun --bun vitest run",
    "test:visual": "bunx playwright test",
    "test:visual:update": "bunx playwright test --update-snapshots"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.3.1",
    "@mui/material": "^6.3.1",
    "@mui/x-charts": "^7.29.1",
    "date-fns": "^4.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.65.0",
    "@stylistic/eslint-plugin": "^2.12.1",
    "@types/bun": "^1.1.16",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6",
    "@vitest/browser-playwright": "^5.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "playwright": "^1.65.0",
    "typescript": "^6",
    "typescript-eslint": "^8.71.1",
    "vite": "^8",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0"
  }
}
